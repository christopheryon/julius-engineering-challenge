{
  "name": "workforce-dashboard-challenge",
  "version": "0.1.0",
  "private": true,
  "description": "Take-home challenge: workforce data dashboard (React + TS + Vite + Express).",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "install:all": "npm install --workspaces --include-workspace-root",
    "dev": "npm-run-all --parallel dev:server dev:client",
    "dev:client": "npm run dev -w client",
    "dev:server": "npm run dev -w server",
    "build": "npm run build -w client",
    "lint": "npm run lint -w client"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  }
}
